{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Irish Economic Overview: GVA, Employment, and Regional Trends",
    "fontSize": 18,
    "anchor": "start"
  },
  "resolve": {"scale": {"color": "independent", "shape": "independent"}},
  "vconcat": [
    {
      "title": "Chart 1: Multi-Year Cumulative GVA Trend by Region",
      "data": {
        "url": "https://raw.githubusercontent.com/OonXiangYu/Information-Visualization-Assignment/refs/heads/main/Cleaned%20Data/employment_by_sector_clean.csv"
      },
      "transform": [
        {"calculate": "datum['NACE Rev. 2 Sector']", "as": "Sector"},
        {
          "calculate": "datum['Gross Value Added (GVA) at Basic Prices'] / 1000000",
          "as": "GVA_Millions"
        },
        {"filter": "datum.Sector != 'All Sectors'"},
        {"filter": "datum['NUTS 2 Region'] != 'Ireland'"}
      ],
      "width": 650,
      "height": 240,
      "mark": {"type": "line", "point": true, "tooltip": true},
      "encoding": {
        "x": {"field": "Year", "type": "ordinal", "title": "Year"},
        "y": {
          "field": "GVA_Millions",
          "type": "quantitative",
          "aggregate": "sum",
          "title": "Total GVA (€ Millions)"
        },
        "color": {
          "field": "NUTS 2 Region",
          "type": "nominal",
          "title": "Region"
        }
      }
    },
    {
      "title": "Chart 2: Regional Productivity Comparison",
      "data": {
        "url": "https://raw.githubusercontent.com/OonXiangYu/Information-Visualization-Assignment/refs/heads/main/Cleaned%20Data/employment_by_sector_clean.csv"
      },
      "transform": [
        {"calculate": "datum['NACE Rev. 2 Sector']", "as": "Sector"},
        {
          "calculate": "datum['Gross Value Added (GVA) at Basic Prices'] / 1000000",
          "as": "GVA_Millions"
        },
        {"filter": "datum.Sector != 'All Sectors'"},
        {"calculate": "toNumber(datum['Year'])", "as": "Year"},
        {"filter": "datum['NUTS 2 Region'] != 'Ireland'"},
        {"filter": {"param": "YearSelect1"}}
      ],
      "facet": {
        "field": "NUTS 2 Region",
        "type": "nominal",
        "header": {"title": "Region Panel"}
      },
      "spec": {
        "width": 280,
        "height": 200,
        "params": [
          {"name": "ZoomPan2", "select": "interval", "bind": "scales"}
        ],
        "mark": {
          "type": "point",
          "filled": true,
          "size": 70,
          "tooltip": true,
          "clip": true
        },
        "encoding": {
          "x": {
            "field": "Total Persons at Work",
            "type": "quantitative",
            "title": "Total Persons at Work",
            "scale": {"domain": [0, 800000], "nice": false}
          },
          "y": {
            "field": "GVA_Millions",
            "type": "quantitative",
            "title": "GVA (€M)",
            "scale": {"domain": [0, 200000], "nice": false}
          },
          "color": {
            "field": "Sector",
            "type": "nominal",
            "title": "NACE Sector"
          }
        }
      }
    },
    {
      "title": {
        "text": "Select Year:",
        "anchor": "start",
        "fontSize": 12,
        "fontWeight": "normal"
      },
      "width": 650,
      "height": 28,
      "data": {
        "values": [
          {"Year": 2000},
          {"Year": 2001},
          {"Year": 2002},
          {"Year": 2003},
          {"Year": 2004},
          {"Year": 2005},
          {"Year": 2006},
          {"Year": 2007},
          {"Year": 2008},
          {"Year": 2009},
          {"Year": 2010},
          {"Year": 2011},
          {"Year": 2012},
          {"Year": 2013},
          {"Year": 2014},
          {"Year": 2015},
          {"Year": 2016},
          {"Year": 2017},
          {"Year": 2018},
          {"Year": 2019},
          {"Year": 2020},
          {"Year": 2021},
          {"Year": 2022},
          {"Year": 2023}
        ]
      },
      "transform": [],
      "encoding": {"x": {"field": "Year", "type": "ordinal", "axis": null}},
      "layer": [
        {
          "params": [
            {
              "name": "YearSelect1",
              "select": {"type": "point", "fields": ["Year"], "clear": false},
              "value": [{"Year": 2023}]
            }
          ],
          "mark": {"type": "rect", "cursor": "pointer", "stroke": "white"},
          "encoding": {
            "color": {
              "condition": {"param": "YearSelect1", "value": "#4c78a8"},
              "value": "#e3e3e3"
            }
          }
        },
        {
          "mark": {"type": "text", "fontSize": 10, "cursor": "pointer"},
          "encoding": {
            "text": {"field": "Year", "type": "ordinal"},
            "color": {
              "condition": {"param": "YearSelect1", "value": "white"},
              "value": "#333"
            }
          }
        }
      ]
    },
    {
      "title": "Chart 3: Population vs Total GDP by Region, 2000-2023 (Bubble Size = GDP per Person)",
      "width": 900,
      "height": 450,
      "data": {
        "url": "https://raw.githubusercontent.com/OonXiangYu/Information-Visualization-Assignment/refs/heads/main/Cleaned%20Data/tax_and_gdp_by_region_clean.csv"
      },
      "transform": [
        {"filter": "datum['NUTS 2 Region'] != 'Ireland'"},
        {
          "filter": "!isArray(RegionSelect.Region) || indexof(RegionSelect.Region, 'All Regions') >= 0 || indexof(RegionSelect.Region, datum['NUTS 2 Region']) >= 0"
        },
        {
          "calculate": "datum['Gross Domestic Product in Current Market Prices'] / 1000000",
          "as": "GDP_Millions"
        }
      ],
      "encoding": {
        "x": {
          "field": "Population",
          "type": "quantitative",
          "title": "Population",
          "scale": {
            "nice": false,
            "domain": {
              "expr": "{'All Regions':[500000,2800000],'Eastern and Midland':[1750000,2650000],'Northern and Western':[550000,950000],'Southern':[1250000,1800000]}[isArray(RegionSelect.Region) ? RegionSelect.Region[0] : 'All Regions']"
            }
          },
          "axis": {
            "format": ",.0f",
            "labelFontSize": 10,
            "titleFontSize": 11,
            "values": {
              "expr": "{'All Regions':[500000,1000000,1500000,2000000,2500000],'Eastern and Midland':[1800000,2000000,2200000,2400000,2600000],'Northern and Western':[600000,700000,800000,900000],'Southern':[1300000,1400000,1500000,1600000,1700000]}[isArray(RegionSelect.Region) ? RegionSelect.Region[0] : 'All Regions']"
            }
          }
        },
        "y": {
          "field": "GDP_Millions",
          "type": "quantitative",
          "title": "Total GDP (€ Millions)",
          "scale": {
            "type": "linear",
            "nice": false,
            "domain": {
              "expr": "{'All Regions':[0,320000],'Eastern and Midland':[50000,320000],'Northern and Western':[10000,50000],'Southern':[30000,210000]}[isArray(RegionSelect.Region) ? RegionSelect.Region[0] : 'All Regions']"
            }
          },
          "axis": {
            "format": ",.0f",
            "labelFontSize": 10,
            "titleFontSize": 11,
            "values": {
              "expr": "{'All Regions':[0,50000,100000,150000,200000,250000,300000],'Eastern and Midland':[50000,100000,150000,200000,250000,300000],'Northern and Western':[10000,20000,30000,40000,50000],'Southern':[30000,60000,90000,120000,150000,180000,210000]}[isArray(RegionSelect.Region) ? RegionSelect.Region[0] : 'All Regions']"
            }
          }
        },
        "color": {
          "field": "NUTS 2 Region",
          "type": "nominal",
          "title": "Region",
          "scale": {
            "domain": [
              "Eastern and Midland",
              "Northern and Western",
              "Southern"
            ],
            "range": ["#4c78a8", "#f58518", "#e45756"]
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "opacity": 0.55,
            "stroke": "white",
            "strokeWidth": 0.5
          },
          "encoding": {
            "size": {
              "field": "Gross Domestic Product (GDP) per Person",
              "type": "quantitative",
              "title": "GDP per Person (€)",
              "scale": {"domain": [15000, 115000], "range": [40, 900]},
              "legend": {"format": ",.0f"}
            },
            "tooltip": [
              {"field": "NUTS 2 Region", "type": "nominal", "title": "Region"},
              {"field": "Year", "type": "ordinal"},
              {"field": "Population", "type": "quantitative", "format": ",.0f"},
              {
                "field": "GDP_Millions",
                "type": "quantitative",
                "title": "Total GDP (€M)",
                "format": ",.0f"
              },
              {
                "field": "Gross Domestic Product (GDP) per Person",
                "type": "quantitative",
                "title": "GDP per Person (€)",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "mark": {"type": "text", "dy": -12, "fontSize": 9},
          "encoding": {"text": {"field": "Year", "type": "ordinal"}}
        }
      ]
    },
    {
      "title": {
        "text": "Region (click to choose):",
        "anchor": "start",
        "fontSize": 12,
        "fontWeight": "normal"
      },
      "width": 900,
      "height": 28,
      "data": {
        "values": [
          {"Region": "All Regions"},
          {"Region": "Eastern and Midland"},
          {"Region": "Northern and Western"},
          {"Region": "Southern"}
        ]
      },
      "encoding": {
        "x": {"field": "Region", "type": "nominal", "axis": null, "sort": null}
      },
      "layer": [
        {
          "params": [
            {
              "name": "RegionSelect",
              "select": {"type": "point", "fields": ["Region"], "clear": false},
              "value": [{"Region": "All Regions"}]
            }
          ],
          "mark": {"type": "rect", "cursor": "pointer", "stroke": "white"},
          "encoding": {
            "color": {
              "condition": {"param": "RegionSelect", "value": "#4c78a8"},
              "value": "#e3e3e3"
            }
          }
        },
        {
          "mark": {"type": "text", "fontSize": 11, "cursor": "pointer"},
          "encoding": {
            "text": {"field": "Region", "type": "nominal"},
            "color": {
              "condition": {"param": "RegionSelect", "value": "white"},
              "value": "#333"
            }
          }
        }
      ]
    },
    {
      "title": "Chart 4: Regional Fiscal Balance, Taxes vs Subsidies by Region (2000-2023)",
      "data": {
        "url": "https://raw.githubusercontent.com/OonXiangYu/Information-Visualization-Assignment/refs/heads/main/Cleaned%20Data/tax_and_gdp_by_region_clean.csv"
      },
      "transform": [
        {"filter": "datum['NUTS 2 Region'] != 'Ireland'"},
        {
          "filter": "!isArray(RegionSelect1.Region) || indexof(RegionSelect1.Region, 'All Regions') >= 0 || indexof(RegionSelect1.Region, datum['NUTS 2 Region']) >= 0"
        },
        {
          "fold": [
            "Product Taxes",
            "Non-Product Taxes",
            "Product Subsidies",
            "Non-Product Subsidies"
          ],
          "as": ["Component", "Value"]
        },
        {"calculate": "datum.Value / 1000000", "as": "Value_M"},
        {
          "calculate": "indexof(['Product Subsidies', 'Non-Product Subsidies'], datum.Component) >= 0 ? -datum.Value_M : datum.Value_M",
          "as": "Signed_M"
        }
      ],
      "facet": {
        "column": {
          "field": "NUTS 2 Region",
          "type": "nominal",
          "header": {
            "title": null,
            "labelFontSize": 12,
            "labelFontWeight": "bold"
          }
        }
      },
      "resolve": {"scale": {"y": "shared"}},
      "spec": {
        "width": 260,
        "height": 280,
        "layer": [
          {
            "mark": {"type": "bar", "tooltip": true},
            "encoding": {
              "x": {
                "field": "Year",
                "type": "ordinal",
                "title": "Year",
                "axis": {
                  "labelAngle": -90,
                  "labelFontSize": 9,
                  "labelOverlap": false,
                  "labelPadding": 4
                }
              },
              "y": {
                "field": "Signed_M",
                "type": "quantitative",
                "aggregate": "sum",
                "title": "€ Millions (taxes above 0, subsidies below 0)",
                "axis": {
                  "format": ",.0f",
                  "labelFontSize": 10,
                  "titleFontSize": 11
                }
              },
              "color": {
                "field": "Component",
                "type": "nominal",
                "title": "Tax / Subsidy Type",
                "scale": {
                  "domain": [
                    "Product Taxes",
                    "Non-Product Taxes",
                    "Product Subsidies",
                    "Non-Product Subsidies"
                  ],
                  "range": ["#4c78a8", "#9ecae1", "#f58518", "#fdbf6f"]
                }
              },
              "tooltip": [
                {
                  "field": "NUTS 2 Region",
                  "type": "nominal",
                  "title": "Region"
                },
                {"field": "Year", "type": "ordinal"},
                {"field": "Component", "type": "nominal", "title": "Type"},
                {
                  "field": "Value_M",
                  "type": "quantitative",
                  "title": "Amount (€M)",
                  "format": ",.0f"
                }
              ]
            }
          },
          {
            "mark": {"type": "rule", "color": "black", "strokeWidth": 1},
            "encoding": {"y": {"datum": 0}}
          }
        ]
      }
    },
    {
      "title": {
        "text": "Region (click to choose):",
        "anchor": "start",
        "fontSize": 12,
        "fontWeight": "normal"
      },
      "width": 900,
      "height": 28,
      "data": {
        "values": [
          {"Region": "All Regions"},
          {"Region": "Eastern and Midland"},
          {"Region": "Northern and Western"},
          {"Region": "Southern"}
        ]
      },
      "encoding": {
        "x": {"field": "Region", "type": "nominal", "axis": null, "sort": null}
      },
      "layer": [
        {
          "params": [
            {
              "name": "RegionSelect1",
              "select": {"type": "point", "fields": ["Region"], "clear": false},
              "value": [{"Region": "All Regions"}]
            }
          ],
          "mark": {"type": "rect", "cursor": "pointer", "stroke": "white"},
          "encoding": {
            "color": {
              "condition": {"param": "RegionSelect1", "value": "#4c78a8"},
              "value": "#e3e3e3"
            }
          }
        },
        {
          "mark": {"type": "text", "fontSize": 11, "cursor": "pointer"},
          "encoding": {
            "text": {"field": "Region", "type": "nominal"},
            "color": {
              "condition": {"param": "RegionSelect1", "value": "white"},
              "value": "#333"
            }
          }
        }
      ]
    },
    {
      "title": "Chart 5: Apparent Productivity Trend by Region, 2000-2023 (Bubble Size = Persons at Work)",
      "width": 1000,
      "height": 480,
      "data": {
        "url": "https://raw.githubusercontent.com/OonXiangYu/Information-Visualization-Assignment/refs/heads/main/Cleaned%20Data/tax_and_gdp_by_region_clean.csv"
      },
      "transform": [
        {"filter": "datum['NUTS 2 Region'] != 'Ireland'"},
        {
          "calculate": "datum['Hours Worked'] / datum['Persons at Work']",
          "as": "Hours_per_Worker"
        }
      ],
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 10,
            "titleFontSize": 11,
            "labelOverlap": false
          }
        },
        "y": {
          "field": "Apparent Productivity",
          "type": "quantitative",
          "title": "Apparent Productivity (€ per person at work)",
          "scale": {"type": "linear", "nice": false, "domain": [0, 240000]},
          "axis": {
            "format": ",.0f",
            "labelFontSize": 10,
            "titleFontSize": 11,
            "values": [0, 40000, 80000, 120000, 160000, 200000, 240000]
          }
        },
        "color": {
          "field": "NUTS 2 Region",
          "type": "nominal",
          "title": "Region",
          "scale": {
            "domain": [
              "Eastern and Midland",
              "Northern and Western",
              "Southern"
            ],
            "range": ["#4c78a8", "#f58518", "#e45756"]
          }
        }
      },
      "layer": [
        {"mark": {"type": "line", "strokeWidth": 1.5, "opacity": 0.3}},
        {
          "mark": {
            "type": "point",
            "filled": true,
            "opacity": 0.6,
            "stroke": "white",
            "strokeWidth": 1.5
          },
          "encoding": {
            "size": {
              "field": "Persons at Work",
              "type": "quantitative",
              "title": "Persons at Work",
              "scale": {"domain": [250000, 1450000], "range": [30, 3500]},
              "legend": {"format": ",.0f"}
            },
            "tooltip": [
              {"field": "NUTS 2 Region", "type": "nominal", "title": "Region"},
              {"field": "Year", "type": "ordinal"},
              {
                "field": "Apparent Productivity",
                "type": "quantitative",
                "title": "Productivity (€ per person)",
                "format": ",.0f"
              },
              {
                "field": "Persons at Work",
                "type": "quantitative",
                "format": ",.0f"
              },
              {
                "field": "Hours Worked",
                "type": "quantitative",
                "format": ",.0f"
              },
              {
                "field": "Hours_per_Worker",
                "type": "quantitative",
                "title": "Hours per Worker",
                "format": ",.0f"
              }
            ]
          }
        }
      ]
    },
    {
      "title": "Chart 8: Compensation per Person at Work by Region, 2000-2023",
      "data": {
        "url": "https://raw.githubusercontent.com/OonXiangYu/Information-Visualization-Assignment/refs/heads/main/Cleaned%20Data/tax_and_gdp_by_region_clean.csv"
      },
      "transform": [
        {"filter": "datum['NUTS 2 Region'] != 'Ireland'"},
        {
          "calculate": "datum['Compensation of Employees'] / datum['Persons at Work']",
          "as": "Comp_per_Person"
        },
        {
          "calculate": "datum['Compensation of Employees'] / 1000000",
          "as": "Comp_Millions"
        }
      ],
      "width": 800,
      "height": 300,
      "encoding": {
        "x": {"field": "Year", "type": "ordinal", "title": "Year"},
        "y": {
          "field": "Comp_per_Person",
          "type": "quantitative",
          "title": "Compensation per Person at Work (€)",
          "axis": {"format": ",.0f"}
        },
        "color": {
          "field": "NUTS 2 Region",
          "type": "nominal",
          "title": "Region"
        }
      },
      "layer": [
        {"mark": {"type": "line"}},
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 60,
            "tooltip": true
          },
          "encoding": {
            "tooltip": [
              {"field": "NUTS 2 Region", "type": "nominal", "title": "Region"},
              {"field": "Year", "type": "ordinal"},
              {
                "field": "Comp_per_Person",
                "type": "quantitative",
                "title": "Compensation per Person (€)",
                "format": ",.0f"
              },
              {
                "field": "Comp_Millions",
                "type": "quantitative",
                "title": "Total Compensation (€M)",
                "format": ",.0f"
              },
              {
                "field": "Persons at Work",
                "type": "quantitative",
                "format": ",.0f"
              }
            ]
          }
        }
      ]
    }
  ],
  "config": {}
}